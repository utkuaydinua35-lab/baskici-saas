{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && .venv/bin/uvicorn app.main:app --port 8000 --reload"
      ],
      "port": 8000
    },
    {
      "name": "yonetim",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "panel",
        "--",
        "--port",
        "5176"
      ],
      "port": 5176
    },
    {
      "name": "vitrin",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd storefront && STORE_SLUG=bernz npx next dev -p 3003"
      ],
      "port": 3003
    },
    {
      "name": "panel-native",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd panel && VITE_API_TABAN=http://localhost:8000 npx vite --port 5177 --strictPort"
      ],
      "port": 5177
    }
  ]
}
