{
  "extends": null,
  "appId": "com.bernzcompany.studio",
  "productName": "BERNZ Stüdyo",
  "directories": { "output": "cikti/studio", "buildResources": "kaynak/varliklar" },
  "files": ["kaynak/**/*", "package.json"],
  "extraMetadata": { "bernzProfil": "studio" },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
    "category": "public.app-category.business",
    "icon": "kaynak/varliklar/icon-studio.icns",
    "artifactName": "BERNZ-Studyo-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "BERNZ Stüdyo",
    "contents": [
      { "x": 150, "y": 190, "type": "file" },
      { "x": 430, "y": 190, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "kaynak/varliklar/icon-studio.ico",
    "artifactName": "BERNZ-Studyo-Kurulum-${version}.${ext}"
  },
  "nsis": {
    "oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "BERNZ Stüdyo"
  }
}
