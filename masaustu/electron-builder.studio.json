{
  "extends": null,
  "appId": "com.bernzcompany.studio",
  "productName": "BERNZ Studio",
  "directories": {
    "output": "cikti/studio",
    "buildResources": "kaynak/varliklar"
  },
  "files": [
    "kaynak/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "bernzProfil": "studio"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "category": "public.app-category.business",
    "icon": "kaynak/varliklar/icon-studio.icns",
    "artifactName": "BERNZ-Studyo-${version}-${arch}.${ext}",
    "identity": null,
    "hardenedRuntime": false
  },
  "dmg": {
    "title": "BERNZ Studio"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "kaynak/varliklar/icon-studio.ico",
    "artifactName": "BERNZ-Studyo-Kurulum-${version}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BERNZ Studio"
  },
  "afterPack": "kaynak/imzala.js"
}
