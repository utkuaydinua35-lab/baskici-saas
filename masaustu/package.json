{
  "name": "bernz-bayi",
  "productName": "BERNZ Bayi",
  "version": "1.0.0",
  "description": "BERNZ Company masaüstü kabuğu — bayi ve yönetim paneli",
  "author": "BERNZ COMPANY",
  "license": "UNLICENSED",
  "private": true,
  "main": "kaynak/main.js",
  "scripts": {
    "basla": "electron .",
    "basla:studio": "BERNZ_PROFIL=studio electron .",
    "paket:bayi:mac": "electron-builder --mac --config electron-builder.bayi.json",
    "paket:bayi:win": "electron-builder --win --config electron-builder.bayi.json",
    "paket:studio:mac": "electron-builder --mac --config electron-builder.studio.json",
    "paket:studio:win": "electron-builder --win --config electron-builder.studio.json",
    "paket:mac": "npm run paket:bayi:mac && npm run paket:studio:mac",
    "paket:win": "npm run paket:bayi:win && npm run paket:studio:win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8"
  },
  "bernzProfil": "bayi"
}
