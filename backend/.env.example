DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost/baskici
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENV=development

# ── iOS uygulama bildirimi (APNs) ─────────────────────────────────────────
# Web Push tarayici icindir; uygulamaya bildirim Apple uzerinden gider.
# .p8 anahtari UCRETLI Apple Developer uyeligi gerektiriyor. Bos birakilirsa
# uygulama bildirimi sessizce KAPALI kalir, sistemin geri kalani calisir.
#   Apple Developer → Certificates, Identifiers & Profiles → Keys → +
#   "Apple Push Notifications service (APNs)" isaretle, .p8'i indir (BIR KEZ).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.bernzcompany.magazapanel
# Xcode'dan telefona kurulan derleme "sandbox"; TestFlight/App Store "production".
APNS_ENV=sandbox
